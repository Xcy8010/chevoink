APP_NAME=启创墨域
APP_ENV=development
APP_PORT=3001
APP_WEB_URL=http://localhost:5173
APP_SERVER_URL=http://localhost:3001
DATABASE_URL=postgresql://<local_user>:<local_password>@localhost:5432/<local_database>?schema=public
AUTH_SESSION_SECRET=replace_with_a_local_random_secret
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# Tencent Cloud SMS for login/register verification
SMS_TENCENT_SECRET_ID=replace_me
SMS_TENCENT_SECRET_KEY=replace_me
SMS_TENCENT_REGION=ap-guangzhou
SMS_TENCENT_SDK_APP_ID=replace_me
SMS_TENCENT_SIGN_NAME=replace_me
SMS_TENCENT_TEMPLATE_ID_AUTH=replace_me
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRES_IN_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60
SMS_CODE_HOURLY_LIMIT=5

VITE_APP_NAME=启创墨域
VITE_API_BASE_URL=
# Agent Loop 前端开关：loop（默认）/ legacy（回退旧面板，Vercel 部署需设为 legacy）
VITE_AGENT_ENGINE=loop

AI_TEXT_BASE_URL=https://api.deepseek.com
AI_TEXT_API_KEY=replace_me
AI_TEXT_MODEL=deepseek-v4-pro
# 单轮 LLM 调用最大输出 token（默认 8192 = deepseek-chat 上限；不配时 DeepSeek 默认仅 4096 会截断长章）
# AI_TEXT_MAX_OUTPUT_TOKENS=8192

# Agent Loop 后端引擎：loop（默认）/ legacy；Vercel 环境自动强制 legacy
AGENT_ENGINE=loop
# AI_AGENT_MODEL=deepseek-v4-pro
# 单次任务最大轮次（默认 100）与 token 总预算（默认 2000000），长任务可再上调
# AGENT_MAX_TURNS=100
# AGENT_RUN_TOKEN_BUDGET=2000000

AI_IMAGE_BASE_URL=https://your-image-provider.example.com/v1/images/generations
AI_IMAGE_API_KEY=replace_me
AI_IMAGE_MODEL=gpt-image-2

# 听书 TTS（Edge TTS 免密钥）：edge 启用 / disabled 全站隐藏听书入口
# TTS_PROVIDER=edge
# TTS_DEFAULT_VOICE=zh-CN-YunjianNeural
# TTS_CACHE_DIR=
# TTS_CACHE_MAX_MB=2048
# TTS_TIMEOUT_MS=30000

# Optional bootstrap owner for `npm run prisma:seed`
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PHONE=
# SEED_OWNER_NICKNAME=站点主理人
# SEED_OWNER_PASSWORD=replace_with_a_strong_password
# SEED_OWNER_ROLE=admin
# SEED_OWNER_BIO=
