generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  author
  admin
}

enum NovelStatus {
  draft
  published
  completed
  archived
}

enum ChapterStatus {
  draft
  published
  scheduled
  archived
}

enum Visibility {
  public
  followers
  private
}

enum CommentTargetType {
  novel
  chapter
  post
}

enum MessageType {
  text
  image
  novelCard
  postCard
  authorCard
  commentCard
  system
}

enum ConversationType {
  direct
  system
}

enum CoverSourceType {
  upload
  ai_generated
}

enum ContentAuditStatus {
  pending
  approved
  rejected
}

enum AiProviderType {
  text
  image
}

enum AgentSessionStatus {
  active
  archived
}

enum AgentRunMode {
  plan
  act
  review
}

enum AgentRunStatus {
  queued
  running
  awaiting_approval
  paused
  completed
  failed
  cancelled
}

enum AgentType {
  writingOrchestrator
  storyPlanner
  draftWriter
  continuityEditor
  styleEditor
  loreLibrarian
  coverPromptAgent
}

enum AgentActionKind {
  planChapter
  draftChapter
  continueChapter
  rewriteSelection
  polishSelection
  reviewContinuity
  generateCoverPrompt
  workspaceAgent
}

enum AgentArtifactType {
  chapterPlan
  chapterDraft
  chapterContinuation
  rewriteSelection
  polishSelection
  continuityReview
  coverPrompt
}

enum ProjectMemoryType {
  novelSummary
  worldbuilding
  characterCard
  chapterSummary
  timelineEvent
  foreshadowing
  stylePreference
  continuityRule
}

enum SmsVerificationPurpose {
  login
  register
  reset_password
  admin_login
  admin_bind
}

/// 隐私可见级别：公开 / 仅自己 / 仅互关可见
enum PrivacyLevel {
  public
  private
  mutual
}

model User {
  id                      String               @id @default(cuid()) @db.VarChar(64)
  email                   String?              @unique @db.VarChar(255)
  phone                   String?              @unique @db.VarChar(32)
  passwordHash            String               @map("password_hash") @db.VarChar(255)
  nickname                String               @db.VarChar(64)
  avatarUrl               String?              @map("avatar_url")
  profileCoverUrl         String?              @map("profile_cover_url")
  bio                     String?
  role                    UserRole             @default(user)
  /** 超级管理（唯一）：仅该账号可在后台设置用户身份（用户↔管理） */
  isSuperAdmin            Boolean              @default(false) @map("is_super_admin")
  isAuthor                Boolean              @default(false) @map("is_author")
  followerCount           Int                  @default(0) @map("follower_count")
  followingCount          Int                  @default(0) @map("following_count")
  novelCount              Int                  @default(0) @map("novel_count")
  postCount               Int                  @default(0) @map("post_count")
  unreadMessageCount      Int                  @default(0) @map("unread_message_count")
  unreadNotificationCount Int                  @default(0) @map("unread_notification_count")
  interactionsSeenAt      DateTime?            @map("interactions_seen_at")
  followersSeenAt         DateTime?            @map("followers_seen_at")
  lastActiveAt            DateTime?            @map("last_active_at")
  /** 封禁时间（NULL = 正常）：后台管理封禁后全站登录态失效 */
  bannedAt                DateTime?            @map("banned_at")
  privacyFollowers        PrivacyLevel         @default(public) @map("privacy_followers")
  privacyFollowing        PrivacyLevel         @default(public) @map("privacy_following")
  privacyLikes            PrivacyLevel         @default(public) @map("privacy_likes")
  privacyFavorites        PrivacyLevel         @default(public) @map("privacy_favorites")
  privacyReplies          PrivacyLevel         @default(public) @map("privacy_replies")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  novels                  Novel[]
  chapters                Chapter[]
  comments                Comment[]
  posts                   Post[]
  sharedInPosts           Post[]               @relation("PostSharedUser")
  coverAssets             CoverAsset[]
  conversationMembers     ConversationMember[]
  messages                Message[]
  aiUsageLogs             AiUsageLog[]
  agentSessions           AgentSession[]
  agentRuns               AgentRun[]
  smsVerificationCodes    SmsVerificationCode[]
  postLikes               PostLike[]
  postBookmarks           PostBookmark[]
  commentLikes            CommentLike[]
  novelFavorites          NovelFavorite[]
  readingProgress         ReadingProgress[]
  paragraphUnderlines     ParagraphUnderline[]
  following               UserFollow[]         @relation("UserFollowFollower")
  followers               UserFollow[]         @relation("UserFollowFollowing")

  @@map("users")
}

model SmsVerificationCode {
  id         String                 @id @default(cuid()) @db.VarChar(64)
  userId     String?                @map("user_id") @db.VarChar(64)
  phone      String                 @db.VarChar(32)
  purpose    SmsVerificationPurpose
  codeHash   String                 @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime               @map("expires_at")
  consumedAt DateTime?              @map("consumed_at")
  attempts   Int                    @default(0)
  provider   String                 @default("tencentcloud") @db.VarChar(32)
  meta       Json?
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  user       User?                  @relation(fields: [userId], references: [id])

  @@index([phone, purpose, createdAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model Novel {
  id              String       @id @default(cuid()) @db.VarChar(64)
  authorId        String       @map("author_id") @db.VarChar(64)
  title           String       @db.VarChar(128)
  displayTitle    String?      @map("display_title") @db.VarChar(128)
  slug            String       @unique @db.VarChar(160)
  summary         String
  categoryId      String?      @map("category_id") @db.VarChar(64)
  categoryName    String?      @map("category_name") @db.VarChar(64)
  tagNames        String[]     @default([]) @map("tag_names")
  status          NovelStatus  @default(draft)
  visibility      Visibility   @default(public)
  coverAssetId    String?      @unique @map("cover_asset_id") @db.VarChar(64)
  coverPrompt     String?      @map("cover_prompt")
  wordCount       Int          @default(0) @map("word_count")
  chapterCount    Int          @default(0) @map("chapter_count")
  commentCount    Int          @default(0) @map("comment_count")
  favoriteCount   Int          @default(0) @map("favorite_count")
  likeCount       Int          @default(0) @map("like_count")
  viewCount       Int          @default(0) @map("view_count")
  lastChapterTitle String?     @map("last_chapter_title") @db.VarChar(128)
  lastPublishedAt DateTime?    @map("last_published_at")
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  author          User         @relation(fields: [authorId], references: [id])
  coverAsset      CoverAsset?  @relation("NovelCover", fields: [coverAssetId], references: [id])
  coverAssets     CoverAsset[] @relation("CoverAssetCandidates")
  chapters        Chapter[]
  comments        Comment[]
  favorites       NovelFavorite[]
  posts           Post[]
  aiUsageLogs     AiUsageLog[]
  agentSessions   AgentSession[]
  agentRuns       AgentRun[]
  projectMemoryEntries ProjectMemoryEntry[]
  readingProgress ReadingProgress[]

  @@index([authorId])
  @@index([status, visibility])
  @@index([categoryId])
  @@index([status, visibility, lastPublishedAt])
  @@index([authorId, updatedAt])
  @@map("novels")
}

model Chapter {
  id           String        @id @default(cuid()) @db.VarChar(64)
  novelId      String        @map("novel_id") @db.VarChar(64)
  authorId     String        @map("author_id") @db.VarChar(64)
  title        String        @db.VarChar(128)
  summary      String?
  content      String
  orderIndex   Int           @map("order_index")
  wordCount    Int           @default(0) @map("word_count")
  status       ChapterStatus @default(draft)
  visibility   Visibility    @default(public)
  commentCount Int           @default(0) @map("comment_count")
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  novel        Novel         @relation(fields: [novelId], references: [id])
  author       User          @relation(fields: [authorId], references: [id])
  comments     Comment[]
  aiUsageLogs  AiUsageLog[]
  agentRuns    AgentRun[]
  projectMemoryEntries ProjectMemoryEntry[]
  paragraphUnderlines ParagraphUnderline[]

  @@unique([novelId, orderIndex])
  @@index([novelId, status])
  @@map("chapters")
}

model Comment {
  id          String             @id @default(cuid()) @db.VarChar(64)
  userId      String             @map("user_id") @db.VarChar(64)
  targetType  CommentTargetType  @map("target_type")
  targetId    String             @map("target_id") @db.VarChar(64)
  novelId     String?            @map("novel_id") @db.VarChar(64)
  chapterId   String?            @map("chapter_id") @db.VarChar(64)
  postId      String?            @map("post_id") @db.VarChar(64)
  parentId    String?            @map("parent_id") @db.VarChar(64)
  rootId      String?            @map("root_id") @db.VarChar(64)
  content     String
  /** 作品评论的评星（1-5）；仅 targetType=novel 的根评论使用 */
  rating      Int?
  /** 段评：评论所属正文段落序号（0 起）；仅 targetType=chapter 的根评论使用 */
  paragraphIndex Int?            @map("paragraph_index")
  likeCount   Int                @default(0) @map("like_count")
  replyCount  Int                @default(0) @map("reply_count")
  auditStatus ContentAuditStatus @default(pending) @map("audit_status")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  author      User               @relation(fields: [userId], references: [id])
  novel       Novel?             @relation(fields: [novelId], references: [id])
  chapter     Chapter?           @relation(fields: [chapterId], references: [id])
  post        Post?              @relation(fields: [postId], references: [id])
  parent      Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]          @relation("CommentReplies")
  likes       CommentLike[]

  @@index([targetType, targetId])
  @@index([targetType, targetId, createdAt])
  @@index([parentId])
  @@index([novelId])
  @@index([chapterId])
  @@index([postId])
  @@map("comments")
}

model Topic {
  id        String   @id @default(cuid()) @db.VarChar(64)
  name      String   @unique @db.VarChar(64)
  slug      String   @unique @db.VarChar(80)
  postCount Int      @default(0) @map("post_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  posts     Post[]
  postLinks PostTopic[]

  @@map("topics")
}

/** 帖子-话题多对多关联（方案 18 §3）：# 解析出的话题全部落这里，Post.topicId 保留主话题兼容旧链路 */
model PostTopic {
  id        String   @id @default(cuid()) @db.VarChar(64)
  postId    String   @map("post_id") @db.VarChar(64)
  topicId   String   @map("topic_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id])
  topic     Topic    @relation(fields: [topicId], references: [id])

  @@unique([postId, topicId])
  @@index([topicId])
  @@map("post_topics")
}

model Post {
  id            String             @id @default(cuid()) @db.VarChar(64)
  userId        String             @map("user_id") @db.VarChar(64)
  topicId       String?            @map("topic_id") @db.VarChar(64)
  relatedNovelId String?           @map("related_novel_id") @db.VarChar(64)
  /** 分享的作者（分享作者主页到社区时写入） */
  sharedUserId  String?            @map("shared_user_id") @db.VarChar(64)
  content       String
  excerpt       String             @db.VarChar(240)
  imageUrls     String[]           @default([]) @map("image_urls")
  likeCount     Int                @default(0) @map("like_count")
  commentCount  Int                @default(0) @map("comment_count")
  favoriteCount Int                @default(0) @map("favorite_count")
  auditStatus   ContentAuditStatus @default(pending) @map("audit_status")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  author        User               @relation(fields: [userId], references: [id])
  topic         Topic?             @relation(fields: [topicId], references: [id])
  relatedNovel  Novel?             @relation(fields: [relatedNovelId], references: [id])
  sharedUser    User?              @relation("PostSharedUser", fields: [sharedUserId], references: [id])
  comments      Comment[]
  likes         PostLike[]
  bookmarks     PostBookmark[]
  topicLinks    PostTopic[]

  @@index([userId])
  @@index([topicId])
  @@index([relatedNovelId])
  @@index([sharedUserId])
  @@index([createdAt])
  @@index([topicId, createdAt])
  @@index([userId, createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid()) @db.VarChar(64)
  postId    String   @map("post_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostBookmark {
  id        String   @id @default(cuid()) @db.VarChar(64)
  postId    String   @map("post_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_bookmarks")
}

model UserFollow {
  id          String   @id @default(cuid()) @db.VarChar(64)
  followerId  String   @map("follower_id") @db.VarChar(64)
  followingId String   @map("following_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model NovelFavorite {
  id        String   @id @default(cuid()) @db.VarChar(64)
  novelId   String   @map("novel_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([novelId, userId])
  @@index([userId])
  @@map("novel_favorites")
}

// 云端书架 + 阅读进度（每个用户对每本书一行）：
// 有记录即在书架中；chapterId 非空表示已开始阅读，scrollPercent 记录章内位置。
// 取代原来仅存 localStorage 的本地书架/进度，实现多设备同步。
model ReadingProgress {
  id            String   @id @default(cuid()) @db.VarChar(64)
  userId        String   @map("user_id") @db.VarChar(64)
  novelId       String   @map("novel_id") @db.VarChar(64)
  novelTitle    String   @map("novel_title") @db.VarChar(128)
  coverUrl      String?  @map("cover_url")
  chapterId     String?  @map("chapter_id") @db.VarChar(64)
  chapterTitle  String?  @map("chapter_title") @db.VarChar(128)
  chapterOrder  Int      @default(0) @map("chapter_order")
  totalChapters Int      @default(0) @map("total_chapters")
  scrollPercent Float    @default(0) @map("scroll_percent")
  addedAt       DateTime @default(now()) @map("added_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([userId])
  @@map("reading_progress")
}

// 阅读器段落划线（方案 20 §2.7）：段级划线，userId+chapterId+paragraphIndex 幂等唯一
model ParagraphUnderline {
  id             String   @id @default(cuid()) @db.VarChar(64)
  userId         String   @map("user_id") @db.VarChar(64)
  novelId        String   @map("novel_id") @db.VarChar(64)
  chapterId      String   @map("chapter_id") @db.VarChar(64)
  paragraphIndex Int      @map("paragraph_index")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, paragraphIndex])
  @@index([userId, chapterId])
  @@map("paragraph_underlines")
}

model CommentLike {
  id        String   @id @default(cuid()) @db.VarChar(64)
  commentId String   @map("comment_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model Conversation {
  id                 String               @id @default(cuid()) @db.VarChar(64)
  type               ConversationType     @default(direct)
  title              String?              @db.VarChar(128)
  avatarUrl          String?              @map("avatar_url")
  unreadCount        Int                  @default(0) @map("unread_count")
  lastMessagePreview String?              @map("last_message_preview") @db.VarChar(240)
  lastMessageAt      DateTime?            @map("last_message_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  members            ConversationMember[]
  messages           Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid()) @db.VarChar(64)
  conversationId String       @map("conversation_id") @db.VarChar(64)
  userId         String       @map("user_id") @db.VarChar(64)
  joinedAt       DateTime     @default(now()) @map("joined_at")
  lastReadAt     DateTime?    @map("last_read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(cuid()) @db.VarChar(64)
  conversationId String    @map("conversation_id") @db.VarChar(64)
  senderId       String    @map("sender_id") @db.VarChar(64)
  type           MessageType
  content        String
  relatedId      String?   @map("related_id") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User      @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CoverAsset {
  id             String          @id @default(cuid()) @db.VarChar(64)
  novelId        String?         @map("novel_id") @db.VarChar(64)
  ownerUserId    String          @map("owner_user_id") @db.VarChar(64)
  sourceType     CoverSourceType @map("source_type")
  imageUrl       String          @map("image_url")
  prompt         String?
  negativePrompt String?         @map("negative_prompt")
  modelName      String?         @map("model_name") @db.VarChar(128)
  width          Int?
  height         Int?
  createdAt      DateTime        @default(now()) @map("created_at")
  owner          User            @relation(fields: [ownerUserId], references: [id])
  novel          Novel?          @relation("CoverAssetCandidates", fields: [novelId], references: [id])
  novelAsCover   Novel?          @relation("NovelCover")

  @@index([ownerUserId])
  @@index([novelId])
  @@map("cover_assets")
}

model AiUsageLog {
  id             String         @id @default(cuid()) @db.VarChar(64)
  userId         String         @map("user_id") @db.VarChar(64)
  novelId        String?        @map("novel_id") @db.VarChar(64)
  chapterId      String?        @map("chapter_id") @db.VarChar(64)
  coverAssetId   String?        @map("cover_asset_id") @db.VarChar(64)
  targetType     String         @map("target_type") @db.VarChar(32)
  targetId       String?        @map("target_id") @db.VarChar(64)
  providerType   AiProviderType @map("provider_type")
  providerMode   String         @map("provider_mode") @db.VarChar(16)
  modelName      String         @map("model_name") @db.VarChar(128)
  action         String         @db.VarChar(64)
  requestTokens  Int?           @map("request_tokens")
  responseTokens Int?           @map("response_tokens")
  durationMs     Int            @map("duration_ms")
  createdAt      DateTime       @default(now()) @map("created_at")
  user           User           @relation(fields: [userId], references: [id])
  novel          Novel?         @relation(fields: [novelId], references: [id])
  chapter        Chapter?       @relation(fields: [chapterId], references: [id])

  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@map("ai_usage_logs")
}

model AgentSession {
  id        String             @id @default(cuid()) @db.VarChar(64)
  userId    String             @map("user_id") @db.VarChar(64)
  novelId   String             @map("novel_id") @db.VarChar(64)
  title     String             @db.VarChar(160)
  status    AgentSessionStatus @default(active)
  lastRunAt DateTime?          @map("last_run_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [id])
  novel     Novel              @relation(fields: [novelId], references: [id])
  runs      AgentRun[]

  @@index([userId, novelId])
  @@index([novelId, updatedAt])
  @@map("agent_sessions")
}

model AgentRun {
  id            String         @id @default(cuid()) @db.VarChar(64)
  sessionId     String         @map("session_id") @db.VarChar(64)
  userId        String         @map("user_id") @db.VarChar(64)
  novelId       String         @map("novel_id") @db.VarChar(64)
  chapterId     String?        @map("chapter_id") @db.VarChar(64)
  mode          AgentRunMode
  action        AgentActionKind
  agentType     AgentType      @map("agent_type")
  status        AgentRunStatus @default(queued)
  inputSummary  String?        @map("input_summary")
  outputSummary String?        @map("output_summary")
  errorMessage  String?        @map("error_message")
  engine        String         @default("legacy") @db.VarChar(16)
  currentTurn   Int            @default(0) @map("current_turn")
  usage         Json?
  startedAt     DateTime?      @map("started_at")
  finishedAt    DateTime?      @map("finished_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  session       AgentSession   @relation(fields: [sessionId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  novel         Novel          @relation(fields: [novelId], references: [id])
  chapter       Chapter?       @relation(fields: [chapterId], references: [id])
  artifacts     AgentArtifact[]
  memoryEntries ProjectMemoryEntry[]
  messages      AgentMessage[]
  events        AgentRunEvent[]

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([novelId, createdAt])
  @@map("agent_runs")
}

model AgentArtifact {
  id           String            @id @default(cuid()) @db.VarChar(64)
  runId        String            @map("run_id") @db.VarChar(64)
  artifactType AgentArtifactType @map("artifact_type")
  title        String            @db.VarChar(160)
  summary      String?
  content      String
  metadata     Json?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  run          AgentRun          @relation(fields: [runId], references: [id])

  @@index([runId, createdAt])
  @@map("agent_artifacts")
}

model AgentMessage {
  id        String   @id @default(cuid()) @db.VarChar(64)
  runId     String   @map("run_id") @db.VarChar(64)
  sessionId String   @map("session_id") @db.VarChar(64)
  role      String   @db.VarChar(16)
  parts     Json
  createdAt DateTime @default(now()) @map("created_at")
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([runId, createdAt])
  @@map("agent_messages")
}

model AgentRunEvent {
  id        String   @id @default(cuid()) @db.VarChar(64)
  runId     String   @map("run_id") @db.VarChar(64)
  seq       Int
  type      String   @db.VarChar(48)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("agent_run_events")
}

model ProjectMemoryEntry {
  id              String            @id @default(cuid()) @db.VarChar(64)
  runId           String?           @map("run_id") @db.VarChar(64)
  novelId         String            @map("novel_id") @db.VarChar(64)
  sourceChapterId String?           @map("source_chapter_id") @db.VarChar(64)
  memoryType      ProjectMemoryType @map("memory_type")
  title           String            @db.VarChar(160)
  content         String
  importance      Int               @default(50)
  embeddingRef    String?           @map("embedding_ref") @db.VarChar(255)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  run             AgentRun?         @relation(fields: [runId], references: [id])
  novel           Novel             @relation(fields: [novelId], references: [id])
  sourceChapter   Chapter?          @relation(fields: [sourceChapterId], references: [id])

  @@index([runId])
  @@index([novelId, memoryType])
  @@index([sourceChapterId])
  @@map("project_memory_entries")
}

/** 后台管理操作审计日志：只增不删，admin_id 不做外键（避免用户删除产生悬挂） */
model AdminAuditLog {
  id         String   @id @default(cuid()) @db.VarChar(64)
  adminId    String   @map("admin_id") @db.VarChar(64)
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(32)
  targetId   String?  @map("target_id") @db.VarChar(64)
  detail     Json     @default("{}")
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
