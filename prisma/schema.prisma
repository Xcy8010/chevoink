model AgentSession {
  id        String             @id @default(cuid()) @db.VarChar(64)
  userId    String             @map("user_id") @db.VarChar(64)
  novelId   String             @map("novel_id") @db.VarChar(64)
  title     String             @db.VarChar(160)
  status    AgentSessionStatus @default(active)
  lastRunAt DateTime?          @map("last_run_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [id])
  novel     Novel              @relation(fields: [novelId], references: [id])
  runs      AgentRun[]
  directives UserDirective[]
  contextCheckpoints ContextCheckpoint[]

  @@index([userId, novelId])
  @@index([novelId, updatedAt])
  @@map("agent_sessions")
}

model AgentRun {
  id            String         @id @default(cuid()) @db.VarChar(64)
  sessionId     String         @map("session_id") @db.VarChar(64)
  userId        String         @map("user_id") @db.VarChar(64)
  novelId       String         @map("novel_id") @db.VarChar(64)
  chapterId     String?        @map("chapter_id") @db.VarChar(64)
  mode          AgentRunMode
  action        AgentActionKind
  agentType     AgentType      @map("agent_type")
  status        AgentRunStatus @default(queued)
  inputSummary  String?        @map("input_summary")
  outputSummary String?        @map("output_summary")
  errorMessage  String?        @map("error_message")
  engine        String         @default("legacy") @db.VarChar(16)
  currentTurn   Int            @default(0) @map("current_turn")
  usage         Json?
  taskSpec      Json?          @map("task_spec")
  startedAt     DateTime?      @map("started_at")
  finishedAt    DateTime?      @map("finished_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  session       AgentSession   @relation(fields: [sessionId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  novel         Novel          @relation(fields: [novelId], references: [id])
  chapter       Chapter?       @relation(fields: [chapterId], references: [id])
  artifacts     AgentArtifact[]
  memoryEntries ProjectMemoryEntry[]
  messages      AgentMessage[]
  events        AgentRunEvent[]
  contextCheckpoints ContextCheckpoint[]

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([novelId, createdAt])
  @@map("agent_runs")
}

model AgentArtifact {
  id           String            @id @default(cuid()) @db.VarChar(64)
  runId        String            @map("run_id") @db.VarChar(64)
  artifactType AgentArtifactType @map("artifact_type")
  title        String            @db.VarChar(160)
  summary      String?
  content      String
  metadata     Json?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  run          AgentRun          @relation(fields: [runId], references: [id])

  @@index([runId, createdAt])
  @@map("agent_artifacts")
}

model AgentMessage {
  id        String   @id @default(cuid()) @db.VarChar(64)
  runId     String   @map("run_id") @db.VarChar(64)
  sessionId String   @map("session_id") @db.VarChar(64)
  role      String   @db.VarChar(16)
  parts     Json
  createdAt DateTime @default(now()) @map("created_at")
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([runId, createdAt])
  @@map("agent_messages")
}

model UserDirective {
  id              String              @id @default(cuid()) @db.VarChar(64)
  userId          String              @map("user_id") @db.VarChar(64)
  novelId         String              @map("novel_id") @db.VarChar(64)
  sessionId       String?             @map("session_id") @db.VarChar(64)
  volumeId        String?             @map("volume_id") @db.VarChar(64)
  chapterId       String?             @map("chapter_id") @db.VarChar(64)
  taskSpecId      String?             @map("task_spec_id") @db.VarChar(64)
  scope           UserDirectiveScope
  kind            UserDirectiveKind
  text            String
  status          UserDirectiveStatus @default(active)
  sourceMessageId String              @map("source_message_id") @db.VarChar(64)
  supersededBy    String?             @map("superseded_by") @db.VarChar(64)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel           Novel               @relation(fields: [novelId], references: [id], onDelete: Cascade)
  session         AgentSession?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([novelId, status, createdAt])
  @@index([sessionId, status])
  @@index([sourceMessageId])
  @@map("user_directives")
}

model ContextCheckpoint {
  id                 String       @id @default(cuid()) @db.VarChar(64)
  sessionId          String       @map("session_id") @db.VarChar(64)
  runId              String?      @map("run_id") @db.VarChar(64)
  sourceMessageCount Int          @map("source_message_count")
  sourceMessageIds   Json         @map("source_message_ids")
  sourceStartedAt    DateTime     @map("source_started_at")
  sourceEndedAt      DateTime     @map("source_ended_at")
  sourceTokens       Int          @map("source_tokens")
  summaryTokens      Int          @map("summary_tokens")
  model              String       @db.VarChar(128)
  version            Int          @default(1)
  sourceHash         String       @map("source_hash") @db.VarChar(64)
  summary            Json
  validation         Json
  createdAt          DateTime     @default(now()) @map("created_at")
  session            AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run                AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("context_checkpoints")
}

model AgentRunEvent {
  id        String   @id @default(cuid()) @db.VarChar(64)
  runId     String   @map("run_id") @db.VarChar(64)
  seq       Int
  type      String   @db.VarChar(48)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("agent_run_events")
}

model ProjectMemoryEntry {
  id              String            @id @default(cuid()) @db.VarChar(64)
  runId           String?           @map("run_id") @db.VarChar(64)
  novelId         String            @map("novel_id") @db.VarChar(64)
  sourceChapterId String?           @map("source_chapter_id") @db.VarChar(64)
  memoryType      ProjectMemoryType @map("memory_type")
  title           String            @db.VarChar(160)
  content         String
  importance      Int               @default(50)
  embeddingRef    String?           @map("embedding_ref") @db.VarChar(255)
  layer           StoryMemoryLayer  @default(L1)
  status          StoryMemoryStatus @default(confirmed)
  reviewStatus    MemoryReviewStatus @default(none) @map("review_status")
  confidence      Float             @default(1)
  version         Int               @default(1)
  embedding       Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  run             AgentRun?         @relation(fields: [runId], references: [id])
  novel           Novel             @relation(fields: [novelId], references: [id])
  sourceChapter   Chapter?          @relation(fields: [sourceChapterId], references: [id])
  evidence        MemoryEvidence[]
  revisions       MemoryRevision[]

  @@index([runId])
  @@index([novelId, memoryType])
  @@index([sourceChapterId])
  @@map("project_memory_entries")
}

model MemoryEvidence {
  id         String           @id @default(cuid()) @db.VarChar(64)
  memoryId   String           @map("memory_id") @db.VarChar(64)
  sourceType MemorySourceType @map("source_type")
  sourceId   String           @map("source_id") @db.VarChar(64)
  revision   Int?
  spanStart  Int?             @map("span_start")
  spanEnd    Int?             @map("span_end")
  quoteHash  String?          @map("quote_hash") @db.VarChar(64)
  confidence Float            @default(1)
  createdAt  DateTime         @default(now()) @map("created_at")
  memory     ProjectMemoryEntry @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([sourceType, sourceId])
  @@map("memory_evidence")
}

model MemoryRevision {
  id           String   @id @default(cuid()) @db.VarChar(64)
  memoryId     String   @map("memory_id") @db.VarChar(64)
  before       String
  after        String
  reason       String   @db.VarChar(255)
  supersededBy String?  @map("superseded_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  memory       ProjectMemoryEntry @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, createdAt])
  @@map("memory_revisions")
}

model StoryEntity {
  id            String   @id @default(cuid()) @db.VarChar(64)
  novelId       String   @map("novel_id") @db.VarChar(64)
  entityType    String   @map("entity_type") @db.VarChar(32)
  canonicalName String   @map("canonical_name") @db.VarChar(128)
  description   String?
  status        StoryMemoryStatus @default(confirmed)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  aliases       EntityAlias[]
  relationsFrom EntityRelation[] @relation("RelationFrom")
  relationsTo   EntityRelation[] @relation("RelationTo")

  @@unique([novelId, entityType, canonicalName])
  @@index([novelId, canonicalName])
  @@map("story_entities")
}

model EntityAlias {
  id        String   @id @default(cuid()) @db.VarChar(64)
  entityId  String   @map("entity_id") @db.VarChar(64)
  alias     String   @db.VarChar(128)
  validFrom Int?     @map("valid_from")
  validTo   Int?     @map("valid_to")
  sourceId  String?  @map("source_id") @db.VarChar(64)
  entity    StoryEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, alias])
  @@index([alias])
  @@map("entity_aliases")
}

model EntityRelation {
  id           String   @id @default(cuid()) @db.VarChar(64)
  fromEntityId String   @map("from_entity_id") @db.VarChar(64)
  toEntityId   String   @map("to_entity_id") @db.VarChar(64)
  relationType String   @map("relation_type") @db.VarChar(64)
  state        String?
  validFrom    Int?     @map("valid_from")
  validTo      Int?     @map("valid_to")
  confidence   Float    @default(1)
  sourceId     String   @map("source_id") @db.VarChar(64)
  revision     Int?
  fromEntity   StoryEntity @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     StoryEntity @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relationType, validFrom])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@map("entity_relations")
}

model ForeshadowThread {
  id          String   @id @default(cuid()) @db.VarChar(64)
  novelId     String   @map("novel_id") @db.VarChar(64)
  title       String   @db.VarChar(160)
  content     String
  plantedAt   String   @map("planted_at") @db.VarChar(64)
  status      String   @default("open") @db.VarChar(24)
  resolvedAt  String?  @map("resolved_at") @db.VarChar(64)
  sourceId    String   @map("source_id") @db.VarChar(64)
  revision    Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
  @@map("foreshadow_threads")
}

model StoryEvent {
  id           String   @id @default(cuid()) @db.VarChar(64)
  novelId      String   @map("novel_id") @db.VarChar(64)
  title        String   @db.VarChar(160)
  description  String
  storyTime    String?  @map("story_time") @db.VarChar(160)
  location     String?  @db.VarChar(160)
  participants Json
  causes       Json
  effects      Json
  sourceId     String   @map("source_id") @db.VarChar(64)
  revision     Int?
  status       StoryMemoryStatus @default(inferred)
