  modelName      String         @map("model_name") @db.VarChar(128)
  action         String         @db.VarChar(64)
  requestTokens  Int?           @map("request_tokens")
  responseTokens Int?           @map("response_tokens")
  durationMs     Int            @map("duration_ms")
