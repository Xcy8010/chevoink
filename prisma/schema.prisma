}

model MemoryExtractionJob {
  id             String   @id @default(cuid()) @db.VarChar(64)
  novelId        String   @map("novel_id") @db.VarChar(64)
  chapterId      String   @map("chapter_id") @db.VarChar(64)
  chapterRevision Int     @map("chapter_revision")
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(160)
  diff           Json
  status         MemoryJobStatus @default(pending)
  attempts       Int      @default(0)
  leaseUntil     DateTime? @map("lease_until")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  novel          Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([chapterId, chapterRevision])
  @@map("memory_extraction_jobs")
}

/** 后台管理操作审计日志：只增不删，admin_id 不做外键（避免用户删除产生悬挂） */
model AdminAuditLog {
  id         String   @id @default(cuid()) @db.VarChar(64)
  adminId    String   @map("admin_id") @db.VarChar(64)
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(32)
  targetId   String?  @map("target_id") @db.VarChar(64)
  detail     Json     @default("{}")
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
