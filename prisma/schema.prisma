  novelId        String?         @map("novel_id") @db.VarChar(64)
  ownerUserId    String          @map("owner_user_id") @db.VarChar(64)
  sourceType     CoverSourceType @map("source_type")
  imageUrl       String          @map("image_url")
  prompt         String?
  negativePrompt String?         @map("negative_prompt")
  modelName      String?         @map("model_name") @db.VarChar(128)
  width          Int?
  height         Int?
  createdAt      DateTime        @default(now()) @map("created_at")
  owner          User            @relation(fields: [ownerUserId], references: [id])
  novel          Novel?          @relation("CoverAssetCandidates", fields: [novelId], references: [id])
  novelAsCover   Novel?          @relation("NovelCover")

  @@index([ownerUserId])
  @@index([novelId])
  @@map("cover_assets")
}

model AiUsageLog {
  id             String         @id @default(cuid()) @db.VarChar(64)
  userId         String         @map("user_id") @db.VarChar(64)
  novelId        String?        @map("novel_id") @db.VarChar(64)
  chapterId      String?        @map("chapter_id") @db.VarChar(64)
