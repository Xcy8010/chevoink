# 测试环境模板（复制为 tests/.env.test 后按需修改；.env.test 已被 .gitignore 排除，不入库）
# 由 tests/setup.ts 通过 DOTENV_PATH 指定加载，不会误读开发 .env
# 库名必须为 chevoink_test 或 chevoink_test_<suffix>；仅允许明确列出的测试主机
# 测试账号必须非超级用户且无建库/建角色/replication/bypassRLS权限；CI强制DB可用
# 仅在隔离测试主机确实需要时设置 TEST_DATABASE_ALLOWED_HOSTS=exact.test.host
# 本地全量验收设置 TEST_DATABASE_REQUIRED=true，禁止以集成skip作为通过
APP_ENV=test
AUTH_SESSION_SECRET=test-session-secret-do-not-use-in-prod
DATABASE_URL=postgresql://127.0.0.1:5432/chevoink_test
